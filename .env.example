# Copy to .env and set a real password, then run:  docker compose up -d
# Admin username is "admin" unless you change ADMIN_USERNAME here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-you-start
# Set to 1 when serving over HTTPS so session cookies are marked Secure.
QUIZ_SECURE_COOKIES=0
# Set to 1 to write a request log to stdout.
QUIZ_LOG=0
